	<array>
		<string>sora-Bold.otf</string>
		<string>sora-ExtraBold.otf</string>
		<string>sora-Regular.otf</string>
		<string>sora-SemiBold.otf</string>
		<string>Sora-Light.otf</string>
	</array>
