	<key>SoraTairaDeploymentManifestSha256</key>
	<string>$(SORA_TAIRA_DEPLOYMENT_MANIFEST_SHA256)</string>
	<key>SoraTairaDeploymentManifestSequenceNumber</key>
	<string>$(SORA_TAIRA_DEPLOYMENT_MANIFEST_SEQUENCE_NUMBER)</string>
