	<string>$(SORA_TAIRA_RETIRED_DEPLOYMENT_EPOCH)</string>
	<key>SoraTairaRetiredGenesisHash</key>
	<string>$(SORA_TAIRA_RETIRED_GENESIS_HASH)</string>
