"No detailed check was recorded by the previous build." = "Tiada semakan terperinci direkodkan oleh binaan terdahulu.";
"No recovery package was published." = "Tiada pakej pemulihan diterbitkan.";
"Open SORA support" = "Buka sokongan SORA";
"Original derivation path (optional)" = "Laluan terbitan asal (pilihan)";
"Protect the returned wallets" = "Lindungi dompet yang dikembalikan";
"Protect your recovery options" = "Lindungi pilihan pemulihan anda";
"Protected export created." = "Eksport terlindung dicipta.";
