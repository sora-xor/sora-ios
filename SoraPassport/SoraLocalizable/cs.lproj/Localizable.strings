/* Wallet recovery and authentication — AI-translated, native review pending (2026-10-12). */
"Restore existing wallet keys" = "Obnovit klíče stávající peněženky";
"Restore from Google Drive backup" = "Obnovit ze zálohy na Google Drive";
"Show my recovery phrase" = "Zobrazit mou obnovovací frázi";
"Set up this iPhone again" = "Znovu nastavit tento iPhone";
"SORA stopped before changing anything and did not delete or replace any wallet data. Try again, restore with your recovery phrase or Google Drive backup, or contact SORA support with the app version shown below. Never share your recovery phrase." = "SORA se zastavila před provedením změn a nesmazala ani nenahradila žádná data peněženky. Zkuste to znovu, obnovte ji pomocí obnovovací fráze nebo zálohy na Google Drive, případně kontaktujte podporu SORA a uveďte níže zobrazenou verzi aplikace. Nikdy nesdílejte svou obnovovací frázi.";
"Enter the PIN you used for SORA on this iPhone to show your recovery phrase." = "Chcete-li zobrazit obnovovací frázi, zadejte PIN, který jste používali pro SORA na tomto iPhonu.";
"Recovery phrase not shown" = "Obnovovací fráze nebyla zobrazena";
"Nothing was changed. Try again, or contact SORA support." = "Nic se nezměnilo. Zkuste to znovu nebo kontaktujte podporu SORA.";
"Could not set up this iPhone again" = "Tento iPhone se nepodařilo znovu nastavit";
"Recovery never deletes wallet keys from this iPhone's Keychain." = "Obnova nikdy nemaže klíče peněženky z Klíčenky tohoto iPhonu.";
"Enter your PIN" = "Zadejte svůj PIN";
"Enter your PIN. SORA needs it once to protect the wallets on this iPhone." = "Zadejte svůj PIN. SORA ho potřebuje jen jednou k ochraně peněženek na tomto iPhonu.";
"%@ changed on this iPhone" = "%@ se na tomto iPhonu změnilo";
"Keep %@" = "Ponechat %@";
"Turn %@ off" = "Vypnout %@";
"PIN" = "PIN";
"Cancel" = "Zrušit";
"Continue" = "Pokračovat";
"That PIN is not correct. Attempts left before a short wait: %d." = "Tento PIN není správný. Počet zbývajících pokusů před krátkou prodlevou: %d.";
"Too many attempts. Try again in %d min, or use your recovery phrase or Google Drive backup." = "Příliš mnoho pokusů. Zkuste to znovu za %d min nebo použijte obnovovací frázi či zálohu na Google Drive.";
"This iPhone already has different saved keys for this wallet. Nothing was changed. Contact SORA support." = "Na tomto iPhonu jsou již pro tuto peněženku uloženy jiné klíče. Nic se nezměnilo. Kontaktujte podporu SORA.";
"No recovery phrase is stored on this iPhone for these wallets." = "Na tomto iPhonu není pro tyto peněženky uložena žádná obnovovací fráze.";
"Your recovery phrase" = "Vaše obnovovací fráze";
"Write these words down in order and keep them offline. Anyone with them can take your funds." = "Zapište si tato slova v uvedeném pořadí a uchovávejte je offline. Kdokoli je zná, může vzít vaše prostředky.";
"Set up this iPhone again?" = "Znovu nastavit tento iPhone?";
"Start fresh?" = "Začít znovu?";
"Earlier data is kept on this iPhone. Nothing is deleted." = "Dřívější data zůstanou na tomto iPhonu. Nic se nesmaže.";
"Set up again" = "Nastavit znovu";
"Welcome back" = "Vítejte zpět";
"Restore wallets found on this iPhone" = "Obnovit peněženky nalezené na tomto iPhonu";
"Restore with recovery phrase" = "Obnovit pomocí obnovovací fráze";
"Restore from Google Drive" = "Obnovit z Google Drive";
"Contact support" = "Kontaktovat podporu";
"Checking the keys saved on this iPhone…" = "Kontrola klíčů uložených na tomto iPhonu…";
"No wallet on this iPhone could be verified. Use your recovery phrase or Google Drive backup." = "Na tomto iPhonu se nepodařilo ověřit žádnou peněženku. Použijte obnovovací frázi nebo zálohu na Google Drive.";
"Nothing was changed" = "Nic se nezměnilo";
"Restored wallet" = "Obnovená peněženka";
"Keys already on this iPhone" = "Klíče již na tomto iPhonu jsou";
"Backup not restored" = "Záloha nebyla obnovena";
"This backup does not match the wallet it was saved for. Nothing was changed." = "Tato záloha neodpovídá peněžence, pro kterou byla uložena. Nic se nezměnilo.";
"This account's keys are not on this iPhone, so it can't send. Your funds are not affected. To send from it, import this account again with its recovery phrase or Google Drive backup." = "Klíče tohoto účtu nejsou na tomto iPhonu, takže z něj nelze odesílat. Vaše prostředky nejsou dotčeny. Chcete-li z něj odesílat, znovu tento účet importujte pomocí jeho obnovovací fráze nebo zálohy na Google Drive.";
"The keys saved for this account on this iPhone could not be verified, so it can't send. They have not been changed, and your funds are not affected. Contact SORA support." = "Klíče uložené pro tento účet na tomto iPhonu se nepodařilo ověřit, takže z něj nelze odesílat. Klíče nebyly změněny a vaše prostředky nejsou dotčeny. Kontaktujte podporu SORA.";
"Some earlier wallet files were moved to a separate folder on this iPhone and the others were left in place. Nothing was deleted. Try again, or contact SORA support." = "Některé dřívější soubory peněženky byly přesunuty do samostatné složky na tomto iPhonu a ostatní zůstaly na místě. Nic nebylo smazáno. Zkuste to znovu nebo kontaktujte podporu SORA.";
"The words are hidden while the screen is being recorded or shared." = "Během nahrávání nebo sdílení obrazovky jsou slova skryta.";
"Some wallets were restored" = "Některé peněženky byly obnoveny";
"Restored: %d. Not restored: %d. The keys of the others were not changed; you can try again from Add account, or restore them with their recovery phrase or Google Drive backup." = "Obnoveno: %d. Neobnoveno: %d. Klíče ostatních nebyly změněny; můžete to zkusit znovu přes Přidat účet nebo je obnovit pomocí jejich obnovovací fráze či zálohy na Google Drive.";
"Restore the wallets found on this iPhone first?" = "Nejprve obnovit peněženky nalezené na tomto iPhonu?";
"Wallets saved on this iPhone can be restored now with the PIN you used before. If you continue without them, their keys stay on this iPhone, and you can restore them later from Add account with that PIN, or with their recovery phrase or Google Drive backup." = "Peněženky uložené na tomto iPhonu lze nyní obnovit pomocí dříve používaného PINu. Pokud budete pokračovat bez nich, jejich klíče zůstanou na tomto iPhonu a později je můžete obnovit přes Přidat účet pomocí tohoto PINu, jejich obnovovací fráze nebo zálohy na Google Drive.";
"Restore them now" = "Obnovit nyní";
"Continue without them" = "Pokračovat bez nich";
"Create or import an account" = "Vytvořit nebo importovat účet";
"Upgrade wallet" = "Upgradovat peněženku";
"Upgrade your wallet" = "Upgradujte svou peněženku";
"This version moves your wallet to a safer storage format. It only takes a moment." = "Tato verze převede vaši peněženku do bezpečnějšího formátu úložiště. Zabere to jen chvíli.";
"Your original keys are not deleted or replaced" = "Vaše původní klíče nebudou smazány ani nahrazeny";
"If a check fails, SORA stops safely and shows your options" = "Pokud kontrola selže, SORA se bezpečně zastaví a zobrazí možnosti";
"What happens during the upgrade?" = "Co se děje během upgradu?";
"SORA found a wallet created by an older app version." = "SORA našla peněženku vytvořenou starší verzí aplikace.";
"SORA checks the recovery data saved by the older version, derives the same SORA account from it, and saves that account in a way that survives interruptions." = "SORA zkontroluje data pro obnovu uložená starší verzí, odvodí z nich stejný účet SORA a uloží jej způsobem odolným vůči přerušení.";
"The original Keychain entry is not deleted or replaced in this release. If any check fails, SORA stops and shows your recovery options instead of creating another wallet." = "Původní záznam v Klíčence se v této verzi nemaže ani nenahrazuje. Pokud některá kontrola selže, SORA se zastaví a zobrazí možnosti obnovy místo vytvoření další peněženky.";
"Updating your wallet. Keep SORA open until this finishes." = "Aktualizace peněženky. Nechte SORA otevřenou, dokud nebude dokončena.";
"We paused to keep your wallet safe" = "Pozastavili jsme postup, aby vaše peněženka zůstala v bezpečí";
"Copy recovery details" = "Kopírovat podrobnosti obnovy";
"Create protected recovery export" = "Vytvořit chráněný export pro obnovu";
"Recovery export help" = "Nápověda k exportu pro obnovu";
"Free up some space" = "Uvolněte místo";
"Free up some storage on this iPhone, then check again. Your accounts and keys have not been changed." = "Uvolněte místo v úložišti tohoto iPhonu a pak kontrolu opakujte. Vaše účty a klíče nebyly změněny.";
"Check again" = "Zkontrolovat znovu";
"Set aside unfinished transaction records" = "Odložit záznamy nedokončených transakcí";
"Set aside unfinished transaction records?" = "Odložit záznamy nedokončených transakcí?";
"SORA will move its records of transactions that were still being confirmed to a separate folder on this iPhone. Nothing is deleted, and your accounts, keys and funds are not changed. SORA will no longer be able to tell you whether your most recent transaction went through, so check your activity before you send it again." = "SORA přesune záznamy transakcí, které ještě čekaly na potvrzení, do samostatné složky na tomto iPhonu. Nic se nesmaže a vaše účty, klíče ani prostředky se nezmění. SORA již nebude moci říci, zda vaše nejnovější transakce proběhla, proto před jejím opětovným odesláním zkontrolujte svou aktivitu.";
"Set aside" = "Odložit";
"Could not set the records aside" = "Záznamy se nepodařilo odložit";
"SORA cannot read its records of transactions that were still being confirmed, so it cannot safely start a new one. Your accounts, keys and funds are not affected. You can set these records aside below. Nothing is deleted." = "SORA nemůže přečíst záznamy transakcí, které ještě čekaly na potvrzení, a proto nemůže bezpečně zahájit novou transakci. Vaše účty, klíče a prostředky nejsou dotčeny. Tyto záznamy můžete níže odložit. Nic se nesmaže.";
"If setting the records aside does not help, contact SORA support with the app version shown below. Never share your recovery phrase." = "Pokud odložení záznamů nepomůže, kontaktujte podporu SORA a uveďte níže zobrazenou verzi aplikace. Nikdy nesdílejte svou obnovovací frázi.";
"SORA also cannot read its records of transactions that were still being confirmed. You can set these records aside below. Nothing is deleted." = "SORA také nemůže přečíst záznamy transakcí, které ještě čekaly na potvrzení. Tyto záznamy můžete níže odložit. Nic se nesmaže.";
"SORA could not read its records of transactions that were still being confirmed when it last checked. Your accounts, keys and funds are not affected." = "Při poslední kontrole SORA nemohla přečíst záznamy transakcí, které ještě čekaly na potvrzení. Vaše účty, klíče a prostředky nejsou dotčeny.";
"Try again. If this screen appears again, contact SORA support with the app version shown below. Never share your recovery phrase." = "Zkuste to znovu. Pokud se tato obrazovka znovu objeví, kontaktujte podporu SORA a uveďte níže zobrazenou verzi aplikace. Nikdy nesdílejte svou obnovovací frázi.";
"Enter your current app PIN to change it." = "Chcete-li změnit PIN, zadejte aktuální PIN aplikace.";
"PIN not changed" = "PIN nebyl změněn";
"Enter the current app PIN to authorize this change." = "Zadejte aktuální PIN aplikace pro schválení této změny.";
"Enter a valid PIN." = "Zadejte platný PIN.";
"The PIN update could not be completed. Try again. Your wallet keys are unchanged." = "Aktualizaci PINu se nepodařilo dokončit. Zkuste to znovu. Klíče vaší peněženky se nezměnily.";
"These wallets have no saved ownership PIN. Restore them with your recovery phrase or Google Drive backup." = "Tyto peněženky nemají uložený PIN vlastníka. Obnovte je pomocí obnovovací fráze nebo zálohy na Google Drive.";
"Enter the PIN that protected these wallets. Only wallets owned by that PIN will be restored, and this app will use that PIN." = "Zadejte PIN, který chránil tyto peněženky. Obnoví se pouze peněženky vlastněné tímto PINem a aplikace bude používat tento PIN.";
"Enter the PIN that protected the wallets you want to restore." = "Zadejte PIN, který chránil peněženky, jež chcete obnovit.";
"Enter this app's PIN. The restored wallets will from now on be protected by this app's PIN." = "Zadejte PIN této aplikace. Obnovené peněženky budou od nynějška chráněny PINem této aplikace.";
"We found SORA data from an earlier install on this iPhone. Choose how to continue. Nothing will be deleted. Wallets saved by older versions without an ownership PIN need your recovery phrase or Google Drive backup." = "Na tomto iPhonu jsme našli data SORA z dřívější instalace. Zvolte, jak pokračovat. Nic se nesmaže. Peněženky uložené staršími verzemi bez PINu vlastníka vyžadují obnovovací frázi nebo zálohu na Google Drive.";
"SORA will start fresh on this iPhone. Wallet keys saved on this iPhone are not deleted, and the earlier wallet data is moved to a separate folder on this iPhone. You can restore any wallet with its recovery phrase or Google Drive backup. Wallets with a saved ownership PIN can also be restored with that PIN." = "SORA začne na tomto iPhonu znovu. Uložené klíče peněženek se nesmažou a dřívější data se přesunou do samostatné složky na tomto iPhonu. Jakoukoli peněženku můžete obnovit pomocí její obnovovací fráze nebo zálohy na Google Drive. Peněženky s uloženým PINem vlastníka lze obnovit také pomocí tohoto PINu.";
"SORA will start fresh on this iPhone. Wallet keys saved on this iPhone are not deleted. You can restore any wallet later with its recovery phrase or Google Drive backup. Wallets with a saved ownership PIN can also be restored from Add account with that PIN." = "SORA začne na tomto iPhonu znovu. Uložené klíče peněženek se nesmažou. Jakoukoli peněženku můžete později obnovit pomocí její obnovovací fráze nebo zálohy na Google Drive. Peněženky s uloženým PINem vlastníka lze obnovit také přes Přidat účet pomocí tohoto PINu.";
"Restore a historical wallet" = "Obnovit historickou peněženku";
"For a 3-, 6-, or 9-word phrase, enter the SORA address of the wallet you want to restore. The phrase and derivation path must match this address before any keys are saved." = "U fráze o 3, 6 nebo 9 slovech zadejte adresu SORA peněženky, kterou chcete obnovit. Než se uloží jakékoli klíče, musí fráze a derivační cesta odpovídat této adrese.";
"A phrase with fewer than 12 words is much easier to guess. After restoring, create a new wallet with a 24-word phrase and move your funds to it." = "Frázi s méně než 12 slovy je mnohem snazší uhodnout. Po obnovení vytvořte novou peněženku s frází o 24 slovech a převeďte do ní své prostředky.";
"Move your funds to a new wallet" = "Převeďte prostředky do nové peněženky";
"This wallet's recovery phrase has fewer than 12 words, which makes it much easier to guess. Create a new wallet with a 24-word phrase and move your funds to it." = "Fráze pro obnovení této peněženky má méně než 12 slov, a proto je mnohem snazší ji uhodnout. Vytvořte novou peněženku s frází o 24 slovech a převeďte do ní své prostředky.";
