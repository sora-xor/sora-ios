"Set up this iPhone again?" = "Configurare di nuovo questo iPhone?";
"Start fresh?" = "Ricominciare da zero?";
"Earlier data is kept on this iPhone. Nothing is deleted." = "I dati precedenti restano su questo iPhone. Nulla viene eliminato.";
"Set up again" = "Configura di nuovo";
"Welcome back" = "Bentornato";
