OTHER_SWIFT_FLAGS = $(inherited) "-DF_DEV"
MARKETING_VERSION = 3.9.2
// Build number: YYYYMMDDNN, greater than every earlier upload (highest
// TestFlight build: 2026102901). CI passes SORA_IOS_BUILD_NUMBER (environment
// or build setting); local builds default to the next 3.9.2 candidate.
CURRENT_PROJECT_VERSION = $(SORA_IOS_BUILD_NUMBER:default=2026103001)

// RetainedMigrationEvidenceHarness is compiled only when this condition is
// set. App Store (Release) builds leave it empty and get the inert stub; a
// qualification build may pass
// Non-App-Store configurations keep the harness for QA.
SORA_EVIDENCE_HARNESS_CONDITION = SORA_MIGRATION_EVIDENCE_HARNESS
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SORA_EVIDENCE_HARNESS_CONDITION)

SORA_APPLICATION_CONFIG = Dev
SORA_MINAMOTO_NETWORK_ID =
FIREBASE_CONFIG = GoogleService-Info-Dev.plist
SORA_NAME = Sora Dev
SORA_GOOGLE_TOKEN = 
SORA_GOOGLE_URL_SCHEME = 
SORA_GOOGLE_TOKEN_DEBUG = 
SORA_GOOGLE_URL_SCHEME_DEBUG = 
SORA_IOS_GOOGLE_TOKEN_PROD = 
SORA_IOS_GOOGLE_URL_SCHEME_PROD = 
