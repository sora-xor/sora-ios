OTHER_SWIFT_FLAGS = $(inherited) "-DF_TEST"
MARKETING_VERSION = 3.9.0
// Build number: YYYYMMDDNN, greater than every earlier upload (highest
// TestFlight build: 2026091402). CI passes SORA_IOS_BUILD_NUMBER (environment
// or build setting); local builds default to the first 3.9.0 candidate.
CURRENT_PROJECT_VERSION = $(SORA_IOS_BUILD_NUMBER:default=2026101001)

SORA_APPLICATION_CONFIG = Test
SORA_MINAMOTO_NETWORK_ID =
FIREBASE_CONFIG = GoogleService-Info-Test.plist
SORA_NAME = Soralution
SORA_GOOGLE_TOKEN = 
SORA_GOOGLE_URL_SCHEME = 
SORA_GOOGLE_TOKEN_DEBUG = 
SORA_GOOGLE_URL_SCHEME_DEBUG = 
SORA_IOS_GOOGLE_TOKEN_PROD = 
SORA_IOS_GOOGLE_URL_SCHEME_PROD = 
