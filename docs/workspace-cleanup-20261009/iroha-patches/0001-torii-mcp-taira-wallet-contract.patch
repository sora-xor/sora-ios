+fn build_transaction_status_poll_arguments(
+    arguments: &Map,
+    tx_hash: &str,
+    status_accept: &str,
+    require_authoritative_global_applied: bool,
+) -> Map {
+    let mut status_arguments = Map::new();
+    status_arguments.insert("hash".into(), Value::String(tx_hash.to_owned()));
+    status_arguments.insert("accept".into(), Value::String(status_accept.to_owned()));
+    if require_authoritative_global_applied {
+        status_arguments.insert("scope".into(), Value::String("global".to_owned()));
+    }
+    if let Some(headers) = arguments.get("headers") {
+        status_arguments.insert("headers".into(), headers.clone());
+    }
+    status_arguments
+}
+
+fn is_ready_terminal_pipeline_status(
+    kind: &str,
+    terminal_statuses: &[String],
+    status_result: &Value,
+    expected_hash: &str,
+    require_authoritative_global_applied: bool,
+) -> bool {
+    if !is_terminal_pipeline_status(kind, terminal_statuses) {
+        return false;
+    }
+    if !require_authoritative_global_applied || !kind.eq_ignore_ascii_case("Applied") {
+        return true;
+    }
+    let Some(body) = status_result.get("body").and_then(Value::as_object) else {
+        return false;
+    };
+    body.get("hash").and_then(Value::as_str) == Some(expected_hash)
+        && body.get("scope").and_then(Value::as_str) == Some("global")
+        && body.get("resolved_from").and_then(Value::as_str) == Some("state")
+        && body
+            .get("status")
+            .and_then(Value::as_object)
+            .and_then(|status| status.get("block_height"))
+            .and_then(Value::as_u64)
+            .is_some_and(|height| height > 0)
+}
