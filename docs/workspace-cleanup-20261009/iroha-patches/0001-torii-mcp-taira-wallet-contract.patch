+fn normalize_verified_transaction_submission(
+    mut submit_result: Value,
+    arguments: &Map,
+) -> Result<(Value, String), String> {
+    let status = submit_result
+        .get("status")
+        .and_then(Value::as_u64)
+        .ok_or_else(|| "submit response missing HTTP status".to_owned())?;
+    if !(200..300).contains(&status) {
+        return Err(format!(
+            "submit response status `{status}` is not successful"
+        ));
+    }
+
+    let content_type = submit_result
+        .get("content_type")
+        .and_then(Value::as_str)
+        .ok_or_else(|| "submit response missing content type".to_owned())?;
+    if content_type != crate::utils::NORITO_MIME_TYPE {
+        return Err(format!(
+            "submit response content type `{content_type}` is not `{}`",
+            crate::utils::NORITO_MIME_TYPE
+        ));
+    }
+    let encoded_receipt = submit_result
+        .get("body")
+        .and_then(Value::as_str)
+        .filter(|body| !body.is_empty())
+        .ok_or_else(|| "submit response missing Norito receipt body".to_owned())?;
+    let receipt = decode_verified_transaction_submission_receipt(encoded_receipt)?;
+    let receipt_hash = receipt.payload.tx_hash.to_string();
+
+    for field in ["hash", "transaction_hash"] {
+        let Some(value) = arguments.get(field) else {
+            continue;
+        };
+        let supplied_hash = value
+            .as_str()
+            .filter(|hash| !hash.is_empty())
+            .ok_or_else(|| format!("`{field}` must be a non-empty string"))?;
+        if supplied_hash != receipt_hash {
+            return Err(format!(
+                "supplied `{field}` does not match verified submission receipt `payload.tx_hash`"
+            ));
+        }
+    }
+
+    let mut receipt_json = json::to_value(&receipt)
+        .map_err(|err| format!("encode verified submission receipt as JSON: {err}"))?;
+    let receipt_payload = receipt_json
+        .get_mut("payload")
+        .and_then(Value::as_object_mut)
+        .ok_or_else(|| "verified submission receipt JSON missing payload object".to_owned())?;
+    // `HashOf`'s lossless Norito JSON form includes a type/checksum wrapper. MCP transaction
+    // status and wallet contracts use the raw lowercase 64-hex hash, so expose that verified
+    // value in this projection. The canonical receipt was verified before this projection; the
+    // original signature and signer remain available for audit rather than JSON re-signing.
+    receipt_payload.insert("tx_hash".to_owned(), Value::String(receipt_hash.clone()));
+    let submit = submit_result
+        .as_object_mut()
+        .ok_or_else(|| "submit response must be an object".to_owned())?;
+    let headers = submit
+        .get_mut("headers")
+        .and_then(Value::as_object_mut)
+        .ok_or_else(|| "submit response headers must be an object".to_owned())?;
+    let header_hash = headers
+        .get("x-iroha-transaction-hash")
+        .and_then(Value::as_str)
+        .ok_or_else(|| "submit response missing `x-iroha-transaction-hash` header".to_owned())?;
+    if header_hash != receipt_hash {
+        return Err(
+            "submit response `x-iroha-transaction-hash` does not match verified submission receipt `payload.tx_hash`"
+                .to_owned(),
+        );
+    }
+    headers.insert(
+        header::CONTENT_TYPE.as_str().to_owned(),
+        Value::String("application/json".to_owned()),
+    );
+    submit.insert("body".into(), receipt_json);
+    submit.insert(
+        "content_type".into(),
+        Value::String("application/json".to_owned()),
+    );
+
+    Ok((submit_result, receipt_hash))
+}
+
+fn decode_verified_transaction_submission_receipt(
+    encoded_receipt: &str,
+) -> Result<iroha_data_model::transaction::TransactionSubmissionReceipt, String> {
+    let bytes = decode_base64_any(encoded_receipt)
+        .ok_or_else(|| "submit response receipt body is not valid base64".to_owned())?;
+    let receipt: iroha_data_model::transaction::TransactionSubmissionReceipt =
+        norito::decode_from_bytes(&bytes)
+            .map_err(|err| format!("decode transaction submission receipt: {err}"))?;
+    receipt
+        .verify()
+        .map_err(|err| format!("verify transaction submission receipt signature: {err}"))?;
+    Ok(receipt)
+}
