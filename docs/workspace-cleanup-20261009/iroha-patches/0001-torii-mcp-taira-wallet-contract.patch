+#[cfg(feature = "app_api")]
+fn instruction_matches_account_and_asset_definition_id(
+    instr: &iroha_data_model::isi::InstructionBox,
+    account: &AccountId,
+    expected: &AssetDefinitionId,
+) -> bool {
+    use iroha_data_model::isi::{
+        BurnBox, CustomInstruction, MintBox, RemoveAssetKeyValue, SetAssetKeyValue,
+        TransferAssetBatch, TransferBox, staking::RecordPublicLaneRewards,
+    };
+    use iroha_executor_data_model::isi::multisig::MultisigInstructionBox;
+
+    let asset_matches =
+        |asset: &AssetId| asset.definition() == expected && asset.account() == account;
+    let any = instr.as_any();
+    if let Some(transfer) = any.downcast_ref::<TransferBox>() {
+        return match transfer {
+            TransferBox::Asset(inner) => {
+                inner.source().definition() == expected
+                    && (inner.source().account() == account || inner.destination() == account)
+            }
+            _ => false,
+        };
+    }
+    if let Some(batch) = any.downcast_ref::<TransferAssetBatch>() {
+        return batch.entries().iter().any(|entry| {
+            entry.asset_definition() == expected
+                && (entry.from() == account || entry.to() == account)
+        });
+    }
+    if let Some(mint) = any.downcast_ref::<MintBox>() {
+        return matches!(mint, MintBox::Asset(inner) if asset_matches(inner.destination()));
+    }
+    if let Some(burn) = any.downcast_ref::<BurnBox>() {
+        return matches!(burn, BurnBox::Asset(inner) if asset_matches(inner.destination()));
+    }
+    if let Some(set) = any.downcast_ref::<SetAssetKeyValue>() {
+        return asset_matches(set.asset());
+    }
+    if let Some(remove) = any.downcast_ref::<RemoveAssetKeyValue>() {
+        return asset_matches(remove.asset());
+    }
+    if let Some(rewards) = any.downcast_ref::<RecordPublicLaneRewards>() {
+        return asset_matches(rewards.reward_asset());
+    }
+    if let Some(custom) = any.downcast_ref::<CustomInstruction>()
+        && let Ok(MultisigInstructionBox::Propose(propose)) =
+            MultisigInstructionBox::try_from(custom.payload())
+    {
+        return propose.instructions.iter().any(|nested| {
+            instruction_matches_account_and_asset_definition_id(nested, account, expected)
+        });
+    }
+    false
+}
