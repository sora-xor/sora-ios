+    private func retainedEntropyKeyBytes(_ keys: InMemoryKeychain) throws -> [String: Data] {
+        try Dictionary(uniqueKeysWithValues: keys.allKeyIdentifiers().map { ($0, try keys.fetchKey(for: $0)) })
+    }
